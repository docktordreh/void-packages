# Template file for 'bitwarden-desktop'
pkgname=bitwarden-desktop
version=2026.10.0
revision=1
archs="x86_64 aarch64"
depends="alsa-lib at-spi2-core cairo cups dbus gtk+3 hicolor-icon-theme libX11
 libatomic libnotify libsecret libXtst libXScrnSaver nss pango xdg-utils"
short_desc="Desktop client for the Bitwarden password manager"
maintainer="Valentin Lechner <valentin_lechner@tutanota.de>"
license="GPL-3.0-only"
homepage="https://bitwarden.com/"
changelog="https://github.com/bitwarden/clients/releases"
nostrip=yes

case "$XBPS_TARGET_MACHINE" in
aarch64*)
    distfiles="https://github.com/bitwarden/clients/releases/download/desktop-v${version}/bitwarden_${version}_arm64.tar.gz"
    checksum="838b07f4bd1967c5f271cd3bea5d2324de7b2105bb83d8a95fcd054019ad6720"
    ;;
x86_64*)
    distfiles="https://github.com/bitwarden/clients/releases/download/desktop-v${version}/bitwarden_${version}_x64.tar.gz"
    checksum="354742a5efa28156b2bd0e0501f7696f6d7a6407f0e33ce4b28d5d90cdd5bfc1"
    ;;
*)
    broken="Unsupported architecture: ${XBPS_TARGET_MACHINE}"
    ;;
esac

do_install() {
    vmkdir usr/lib/${pkgname}
    vmkdir usr/bin
    vmkdir usr/share/applications
    vcopy * usr/lib/${pkgname}
    ln -s /usr/lib/${pkgname}/bitwarden "${DESTDIR}/usr/bin/bitwarden"

    chmod 4755 "${DESTDIR}/usr/lib/${pkgname}/chrome-sandbox"
    vinstall resources/com.bitwarden.desktop.desktop 0644 usr/share/applications
    for size in 16 32 64 128 256 512 1024; do
        vinstall "resources/icons/${size}x${size}.png" 0644 \
            "usr/share/icons/hicolor/${size}x${size}/apps" \
            com.bitwarden.desktop.png
    done
}
