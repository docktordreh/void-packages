# Template file for 'orcaslicer'
pkgname=orcaslicer
version=2.5.1
revision=2
archs="x86_64 aarch64"
build_style=cmake
python_version=ignore
wrksrc="OrcaSlicer-${version}"
hostmakedepends="autoconf automake cmake extra-cmake-modules file gettext git
 libtool m4 nasm ninja patchelf pkg-config python3 texinfo"
makedepends="dbus-devel eglexternalplatform eudev-libudev-devel gtk+3-devel
 gst-plugins-base1-devel gstreamer1-devel libcurl-devel libmspack-devel
 libsecret-devel libspnav-devel MesaLib-devel openssl-devel libwebkit2gtk41-devel"
# Boost's binary-float headers include quadmath.h on x86_64.
if [ "$XBPS_TARGET_MACHINE" = x86_64 ]; then
	makedepends+=" libquadmath-devel"
fi
depends="gtk+3 libsecret libwebkit2gtk41"
noshlibprovides=yes # Bundled libraries are private to OrcaSlicer.
# Orca resolves its bundled uv from the resources directory at runtime.
ignore_elf_files="/usr/share/OrcaSlicer/tools/uv/uv"
short_desc="G-code generator for 3D printers"
maintainer="Valentin Lechner <valentin_lechner@tutanota.de>"
license="AGPL-3.0-only"
homepage="https://www.orcaslicer.com/"
changelog="https://github.com/OrcaSlicer/OrcaSlicer/releases"
distfiles="https://github.com/OrcaSlicer/OrcaSlicer/archive/refs/tags/v${version}.tar.gz"
checksum="7f04a53c7680816d2b54063dc4b88950607e5486240f2d0292919f8b6652cdb3"

do_configure() {
	cmake -S deps -B deps/build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DDEP_WX_GTK3=ON
}

do_build() {
	cmake --build deps/build --parallel "${XBPS_MAKEJOBS}"
	# Single-config Ninja stages FFmpeg in build/src for the install rule.
	cmake -S . -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DSLIC3R_FHS=ON \
		-DSLIC3R_PCH=OFF \
		-DORCA_TOOLS=ON
	cmake --build build --config Release --parallel "${XBPS_MAKEJOBS}" \
		--target OrcaSlicer OrcaSlicer_profile_validator generate_system_cache
	./scripts/run_gettext.sh
}

do_install() {
	local lib

	DESTDIR="${DESTDIR}" cmake --install build --config Release --prefix /usr
	# The executable's RUNPATH does not cover dependencies between FFmpeg libraries.
	for lib in "${DESTDIR}"/usr/lib/orcaslicer/*.so.*; do
		[ -L "$lib" ] && continue
		patchelf --set-rpath "\$ORIGIN" "$lib"
	done

	# Orca links to bundled libpython, but its FHS install rules omit that runtime.
	vmkdir usr/libpython
	cp -a deps/build/OrcaSlicer_dep/usr/local/libpython/. "${DESTDIR}/usr/libpython/"
	ln -s /usr/libpython "${DESTDIR}/usr/share/OrcaSlicer/python"
	vlicense LICENSE.txt
}
