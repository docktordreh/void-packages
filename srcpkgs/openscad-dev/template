post_extract() {
	mv openscad-${_commit} ${build_wrksrc}
	rm -rf ${build_wrksrc}/libraries/MCAD ${build_wrksrc}/submodules/Clipper2
	rm -rf ${build_wrksrc}/submodules/OpenCSG ${build_wrksrc}/submodules/manifold
	rm -rf ${build_wrksrc}/submodules/mimalloc ${build_wrksrc}/submodules/sanitizers-cmake
	mv MCAD-${_mcad} ${build_wrksrc}/libraries/MCAD
	mv Clipper2-${_clipper2} ${build_wrksrc}/submodules/Clipper2
	mv OpenCSG-${_opencsg} ${build_wrksrc}/submodules/OpenCSG
	mv manifold-${_manifold} ${build_wrksrc}/submodules/manifold
	mv mimalloc-${_mimalloc} ${build_wrksrc}/submodules/mimalloc
	mv sanitizers-cmake-${_sanitizers_cmake} ${build_wrksrc}/submodules/sanitizers-cmake
}
