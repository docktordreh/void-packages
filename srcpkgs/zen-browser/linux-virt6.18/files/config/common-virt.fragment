# Guest baseline. Values not mentioned here inherit Void's kernel policy.
CONFIG_VIRTUALIZATION=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HOTPLUG_CPU=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y

# General-purpose userspace and containers.
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IO_URING=y

# Guest storage and filesystems.
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=m
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_FS=m
CONFIG_VIRTIO_RNG=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_MEM=m
CONFIG_VIRTIO_INPUT=m
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_DM_CRYPT=m
CONFIG_BLK_DEV_DM=m
CONFIG_BLK_DEV_LOOP=m

# Normal IP networking and container plumbing.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m

# Virtual graphics and the display handoff used by desktop guests.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_HYPERV=m

# These families have no useful VM-only role. USB audio remains enabled in
# usb-passthrough.fragment and is intentionally not gated by MEDIA_SUPPORT.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WWAN is not set
# CONFIG_NFC is not set
# CONFIG_WIMAX is not set
# CONFIG_FIREWIRE is not set
# CONFIG_THUNDERBOLT is not set
# CONFIG_IIO is not set
# CONFIG_HWMON is not set
# CONFIG_MTD is not set
# CONFIG_PCCARD is not set
# CONFIG_ISDN is not set
# CONFIG_RFKILL is not set
# CONFIG_ATA is not set
# CONFIG_SATA_HOST is not set
# CONFIG_SND_HDA is not set
# CONFIG_SND_PCI is not set
# CONFIG_SND_SOC is not set

# Physical Ethernet vendor families. Virtual/cloud vendors are kept below.
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_ADAPTEC is not set
