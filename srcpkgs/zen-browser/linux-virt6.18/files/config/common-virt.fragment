# Intel's vendor menu also contains the useful E1000 family.
# CONFIG_IGB is not set
# CONFIG_IGC is not set
# CONFIG_IXGBE is not set
# CONFIG_IXGBEVF is not set
# CONFIG_I40E is not set
# CONFIG_IAVF is not set
# CONFIG_ICE is not set
# CONFIG_FM10K is not set

# Physical GPU families; virtual and generic DRM remain above.
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_I915=n
CONFIG_DRM_XE=n
CONFIG_DRM_ETNAVIV=n
CONFIG_DRM_LIMA=n
