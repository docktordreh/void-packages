# Template file for 'sbx'
pkgname=sbx
version=0.49.2
revision=1
archs="x86_64 aarch64"
wrksrc=docker-sbx
nostrip=yes
short_desc="Docker Sandboxes CLI"
maintainer="Valentin Lechner <valentin_lechner@tutanota.de>"
license="custom:Proprietary"
homepage="https://docs.docker.com/ai/sandboxes/"
changelog="https://github.com/docker/sbx-releases/releases"

if [ "$XBPS_TARGET_LIBC" = musl ]; then
    broken="Upstream release requires glibc"
fi

case "$XBPS_TARGET_MACHINE" in
x86_64*)
    distfiles="https://github.com/docker/sbx-releases/releases/download/v${version}/DockerSandboxes-linux-amd64.tar.gz"
    checksum=a3f363998cd9f6caa7b02323a5d671987a9887a278fb888aca20fa9f80851e87
    ;;
aarch64*)
    distfiles="https://github.com/docker/sbx-releases/releases/download/v${version}/DockerSandboxes-linux-arm64.tar.gz"
    checksum=53c5250c480b8ef671d89413d824af62e08575c3b0051570dc5efa9f48a94eb6
    ;;
*)
    broken="Unsupported architecture: ${XBPS_TARGET_MACHINE}"
    ;;
esac

do_install() {
    vmkdir usr/libexec/lib
    vbin sbx

    for file in containerd-shim-nerdbox-v1 mkfs.erofs mkfs.ext4; do
        vinstall "$file" 755 usr/libexec
    done
    if [ -f containerd-shim-nerdbox-gpu-v1 ]; then
        vinstall containerd-shim-nerdbox-gpu-v1 755 usr/libexec
    fi
    for file in nerdbox-kernel-* nerdbox-rootfs-*.erofs; do
        [ -f "$file" ] && vinstall "$file" 644 usr/libexec
    done
    vinstall libsailor.so 755 usr/libexec/lib
    vinstall apparmor-profile 644 etc/apparmor.d docker-sbx-nerdbox-shim

    vlicense LICENSE
    vlicense THIRD-PARTY-NOTICES
}
